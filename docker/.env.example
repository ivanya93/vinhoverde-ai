# Copy to .env in THIS folder (next to docker-compose.yml) and fill in.
#   cp .env.example .env
# .env is gitignored. Never commit it, never paste keys in chat or code.

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pinned on purpose (free-tier friendly). See src/llm_client.py.
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=2000

# Kaggle token for the Wine Reviews download: kaggle.com -> Settings -> API -> Create token.
# Optional — you can also download the CSV by hand into data/raw/.
KAGGLE_USERNAME=
KAGGLE_KEY=
